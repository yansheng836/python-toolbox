  "cards": [
    {
      "dot": "cyan",
      "title": "入口与主窗口",
      "items": [
        "main.py 创建 QApplication 与 AppSettings，随后构造 ToolboxWindow",
        "侧边栏支持折叠动画，QStackedWidget 承载首页与各插件页",
        "内置 WelcomePage 功能卡片与 SettingsPlugin 设置页"
      ]
    },
    {
      "dot": "emerald",
      "title": "插件系统",
      "items": [
        "config.py 的 PLUGIN_MODULES 是插件元数据单一数据源",
        "load_plugins 用 importlib 动态导入，按 order 排序注册",
        "9 个功能插件继承 ToolPlugin，统一实现 create_ui / update_theme / load_settings"
      ]
    },
    {
      "dot": "violet",
      "title": "后台与公共组件",
      "items": [
        "BaseWorker 继承 QThread，提供 progress / status / result 信号",
        "长任务在后台线程执行，通过信号回传进度与结果",
        "FileListPanel、ActionPanel、Card、SelectableLabel 等公共控件复用"
      ]
    },
    {
      "dot": "amber",
      "title": "配置与国际化",
      "items": [
        "AppSettings 原子写 config.ini：[setting.*] 全局、[plugin.<id>] 插件",
        "插件设置仅在窗口关闭时随 save_geometry 统一落盘",
        "i18n 用 JSON 词典 + language_changed 信号即时刷新界面"
      ]
    }
  ]
